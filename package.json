{
  "name": "design-desk",
  "version": "0.4.0",
  "private": true,
  "description": "设计台：个人品牌设计工作流（本机运行）",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4180",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4180",
    "check": "tsc --noEmit && next build --webpack",
    "preview": "next build --webpack && cp -r .next/static .next/standalone/.next/ && DESIGN_DESK_DATA_DIR=./.local-data PORT=4180 HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "demo": "node demo/build.mjs",
    "package": "bash packaging/build-package.sh",
    "test:flow": "node tests/flow.cjs"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.9.3"
  }
}
